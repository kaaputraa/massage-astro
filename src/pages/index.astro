---
import BaseLayout from "../layouts/BaseLayout.astro";
import ServiceCard from "../components/ServiceCard.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";

const layanan = [
  { title: "Balinese Massage", price: 200000, duration: 60 },
  { title: "Deep Tissue", price: 250000, duration: 60 },
  { title: "Reflexology", price: 150000, duration: 45 },
];
---

<BaseLayout
  title="Massage Canggu | Ke Villa atau Hotel Anda"
  description="Terapis profesional datang ke villa atau hotel Anda di Canggu. Booking lewat WhatsApp, bayar setelah sesi."
>
  <main class="mx-auto max-w-5xl px-4 py-16">
    <header class="text-center">
      <h1 class="text-4xl font-bold">Massage Canggu</h1>
      <p class="mt-3 text-stone-600">Terapis datang ke villa atau hotel Anda.</p>
      <div class="mt-6">
        <WhatsAppButton />
      </div>
    </header>

    <section class="mt-16">
      <h2 class="text-2xl font-semibold">Layanan</h2>
      <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {layanan.map((l) => <ServiceCard {...l} />)}
      </div>
    </section>
  </main>
</BaseLayout>