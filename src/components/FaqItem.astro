---
interface Props {
  question: string;
  answer: string;
}
const { question, answer } = Astro.props;
---

<details class="group rounded-xl border border-stone-200 bg-white p-4">
  <summary class="cursor-pointer font-medium">{question}</summary>
  <p class="mt-2 text-stone-700">{answer}</p>
</details>