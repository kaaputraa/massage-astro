---
interface Props {
  question: string;
  answer: string;
}
const { question, answer } = Astro.props;
---

<details class="group rounded-2xl border border-mist-200 bg-white p-4 open:border-forest-700">
  <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold [&::-webkit-details-marker]:hidden">
    {question}
    <span
      class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-leaf-400 text-lg text-forest-900 transition group-open:rotate-45"
      aria-hidden="true"
    >+</span>
  </summary>
  <p class="mt-3 text-muted">{answer}</p>
</details>