---
import { getCollection, type CollectionEntry } from "astro:content";
import type { ImageMetadata } from "astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "./Container.astro";
import Tag from "./Tag.astro";
import Section from "./Section.astro";
import Button from "./Button.astro";
import Icon from "./Icon.astro";
import Photo from "./Photo.astro";
import ServiceCard from "./ServiceCard.astro";
import ServicePicker from "./ServicePicker.astro";
import FaqItem from "./FaqItem.astro";
import CtaBanner from "./CtaBanner.astro";
import { useT, pathFor, type Lang } from "../i18n/ui";
import { site, waLink } from "../config/site";
import AnimatedTitle from "./AnimatedTitle.astro";

interface Props {
  lang: Lang;
  area: CollectionEntry<"area">["data"];
  slug: string;
}
const { lang, area, slug } = Astro.props;
const t = useT(lang);

const layanan = await getCollection("layanan");
const faq = await getCollection("faq");
const semuaArea = await getCollection("area");
const lain = semuaArea.filter((a) => a.id !== slug);

// Foto opsional: src/assets/area/<slug>.jpg (atau .jpeg, .png, .webp)
const photoFiles = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/area/*.{jpg,jpeg,png,webp}",
  { eager: true },
);
const photo = Object.entries(photoFiles).find(
  ([path]) => /\/([^/]+)\.[a-z]+$/.exec(path)?.[1] === slug,
)?.[1].default;

const tones = ["forest", "lime", "mist", "white"] as const;
const arts = ["lotus", "stones", "wave", "leaf"] as const;

const facts = [
  { icon: "clock", label: t("arrival"), value: area.waktuTiba[lang] },
  { icon: "wallet", label: t("factPayLabel"), value: t("trustPay") },
  { icon: "pin", label: t("footerHours"), value: site.hours[lang] },
] as const;
---

<BaseLayout
  lang={lang}
  title={area.judul[lang]}
  description={area.deskripsi[lang]}
  alternates={{ id: `/area/${slug}/`, en: `/en/area/${slug}/` }}
>
  <main id="main">
    <!-- Hero -->
    <section class="pb-16 pt-8 sm:pt-12" data-parallax>
      <Container>
        <nav aria-label="Breadcrumb" class="mb-6 text-sm text-muted">
          <a href={pathFor(lang, "/")} class="underline">{t("home")}</a>
          <span aria-hidden="true"> / </span>
          <span>{area.nama}</span>
        </nav>

        <div class="grid items-center gap-12 lg:grid-cols-2">
          <div>
            <div class="hero-rise"><Tag tone="lime">{t("serviceAreas")}</Tag></div>
              <AnimatedTitle text={t("areaH1A")} highlight={area.nama} class="mt-5 text-4xl font-semibold leading-[1.1] sm:text-6xl" />
            <p class="mt-5 max-w-xl text-lg text-muted hero-rise" style="--d:600ms">{area.intro[lang]}</p>

            <ul class="mt-6 flex flex-wrap gap-2 hero-rise" style="--d:750ms">
              {area.cocokUntuk[lang].map((c) => (
                <li class="inline-flex items-center gap-2 rounded-full border border-forest-900/20 px-3 py-1 text-sm">
                  <Icon name="check" size={14} /> {c}
                </li>
              ))}
            </ul>

            <div class="mt-8 flex flex-wrap items-center gap-4 hero-rise" style="--d:900ms">
              <Button href={waLink(t("waMessageArea", { area: area.nama }))} variant="lime" size="lg" external>
                <Icon name="chat" /> {t("bookWa")}
              </Button>
              <a href="#pesan" class="inline-flex items-center gap-3 font-semibold text-forest-800">
                <span class="grid h-12 w-12 place-items-center rounded-full bg-forest-900 text-leaf-400">
                  <Icon name="arrow" />
                </span>
                {t("pickerTag")}
              </a>
            </div>
          </div>

          <div class="relative mx-auto w-full max-w-md lg:max-w-lg">
              <div class="ripple-stage" aria-hidden="true">
                <span class="ripple-ring" style="--r:0"></span>
                <span class="ripple-ring" style="--r:1"></span>
                <span class="ripple-ring" style="--r:2"></span>
                <!-- <span class="ripple-ring" style="--r:3"></span> -->
                <span class="ripple-drop"></span>
              </div>
              <div class="hero-photo relative aspect-[5/4] overflow-hidden rounded-[2rem] shadow-xl">
                <div class="parallax-photo absolute inset-0">
                  <Photo
                    src={photo}
                    alt={t("massageIn", { area: area.nama })}
                    label={`Foto area ${area.nama}`}
                    fill
                    eager
                    sizes="(min-width: 1024px) 512px, 100vw"
                  />
                </div>
              </div>
          </div>
        </div>

        <ul data-stagger="120" class="mt-12 grid gap-4 md:grid-cols-3">
          {facts.map((f) => (
            <li class="flex items-center gap-4 rounded-2xl border border-mist-200 bg-white p-5">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-leaf-100 text-forest-800">
                <Icon name={f.icon} />
              </span>
              <span class="leading-tight">
                <span class="block text-xs font-semibold uppercase tracking-wider text-muted">{f.label}</span>
                <span class="mt-1 block font-semibold">{f.value}</span>
              </span>
            </li>
          ))}
        </ul>
      </Container>
    </section>

    <!-- Titik yang dijangkau (tampil hanya kalau datanya diisi) -->
    {area.landmarks && area.landmarks[lang].length > 0 && (
      <Section
        tag={t("landmarksTag", { area: area.nama })}
        title={t("landmarksTitleA")}
        highlight={area.nama}
        class="!pt-0"
      >
        <ul data-stagger="70" class="flex flex-wrap gap-3">
          {area.landmarks[lang].map((l) => (
            <li class="inline-flex items-center gap-2 rounded-full bg-white px-5 py-3 font-medium shadow-sm ring-1 ring-mist-200">
              <Icon name="pin" size={18} class="text-forest-700" /> {l}
            </li>
          ))}
        </ul>
      </Section>
    )}

    <!-- Layanan -->
    <Section tag={t("services")} title={t("areaServicesA")} highlight={area.nama} aside={t("servicesAside")}>
      <div data-stagger="110" class="lift-children grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {layanan.map((l, i) => (
          <ServiceCard
            title={l.data.title[lang]}
            price={l.data.price}
            duration={l.data.duration}
            description={l.data.description[lang]}
            minutesLabel={t("minutes")}
            tone={tones[i % tones.length]}
            art={arts[i % arts.length]}
            href={waLink(t("waMessageServiceArea", { service: l.data.title[lang], area: area.nama }))}
            ctaLabel={t("bookService", { service: l.data.title[lang] })}
          />
        ))}
      </div>
    </Section>

    <!-- Pemilih pesanan, area sudah terpilih -->
    <ServicePicker lang={lang} defaultArea={area.nama} />

    <!-- Area lain -->
    {lain.length > 0 && (
      <Section tag={t("otherAreasTag")} title={t("otherAreasTitleA")} highlight={t("otherAreasTitleHl")}>
        <ul data-stagger="80" class="lift-children grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {lain.map((a) => (
            <li>
              <a
                href={pathFor(lang, `/area/${a.id}/`)}
                class="group flex items-center justify-between rounded-2xl border border-mist-200 bg-white px-6 py-5 font-semibold transition hover:border-forest-700"
              >
                {t("massageIn", { area: a.data.nama })}
                <span class="grid h-10 w-10 place-items-center rounded-full bg-leaf-400 text-forest-900 transition group-hover:translate-x-1">
                  <Icon name="arrow" />
                </span>
              </a>
            </li>
          ))}
        </ul>
      </Section>
    )}

    <Section tag={t("faq")} title={t("faqTitle")}>
      <div class="grid items-start gap-3 md:grid-cols-2">
        {faq.map((f) => (
          <FaqItem question={f.data.question[lang]} answer={f.data.answer[lang]} />
        ))}
      </div>
    </Section>

    <CtaBanner lang={lang} />
  </main>
</BaseLayout>