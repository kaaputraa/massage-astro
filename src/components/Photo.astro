---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Icon from "./Icon.astro";

interface Props {
  src?: ImageMetadata;
  alt: string;
  label: string;
  ratio?: string;
  fill?: boolean;
  contain?: boolean;
  position?: string;
  eager?: boolean;
  sizes?: string;
  class?: string;
}

const {
  src,
  alt,
  label,
  ratio = "4/3",
  fill = false,
  contain = false,
  position = "center",
  eager = false,
  sizes = "(min-width: 1024px) 50vw, 100vw",
  class: className,
} = Astro.props;

const box = fill ? "absolute inset-0 h-full w-full" : "h-full w-full";
const fit = contain ? "object-contain" : "object-cover";
const ratioStyle = fill ? "" : `aspect-ratio:${ratio}`;
const imgStyle = [ratioStyle, `object-position:${position}`].filter(Boolean).join(";");
---

{src ? (
  <Image
    src={src}
    alt={alt}
    widths={[480, 800, 1200]}
    sizes={sizes}
    loading={eager ? "eager" : "lazy"}
    fetchpriority={eager ? "high" : "auto"}
    style={imgStyle}
    class:list={[box, fit, className]}
  />
) : (
  <div
    role="img"
    aria-label={alt}
    style={ratioStyle || undefined}
    class:list={[
      box,
      "flex flex-col items-center justify-center gap-2 bg-gradient-to-br from-forest-100 via-mist-100 to-leaf-100 p-4 text-center text-forest-700",
      className,
    ]}
  >
    <Icon name="camera" size={32} />
    <span class="text-sm font-semibold">{label}</span>
    <span class="text-xs opacity-70">Ganti dengan foto asli</span>
  </div>
)}