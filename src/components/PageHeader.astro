---
import Container from "./Container.astro";
import Tag from "./Tag.astro";
import ServiceArt from "./ServiceArt.astro";
import AnimatedTitle from "./AnimatedTitle.astro";

interface Props {
  tag: string;
  title: string;
  highlight?: string;
  intro?: string;
  art?: "lotus" | "stones" | "wave" | "leaf";
}

const { tag, title, highlight, intro, art } = Astro.props;
---

<section class="relative overflow-x-clip pb-2 pt-8 sm:pt-12">
  {art && (
    <div
      class="hero-rise pointer-events-none absolute -right-10 top-2 hidden md:block"
      style="--d:400ms"
      aria-hidden="true"
    >
      <ServiceArt kind={art} class="float-slower h-72 w-72 text-leaf-400/40" />
    </div>
  )}

  <Container class="relative">
    <div class="max-w-3xl">
      <div class="hero-rise"><Tag tone="lime">{tag}</Tag></div>
      <AnimatedTitle
        text={title}
        highlight={highlight}
        class="mt-4 text-4xl font-semibold leading-tight sm:text-5xl"
      />
      {intro && (
        <p class="hero-rise mt-4 text-lg text-muted" style="--d:600ms">{intro}</p>
      )}
    </div>
  </Container>
</section>