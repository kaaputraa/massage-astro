---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "./PageHeader.astro";
import Container from "./Container.astro";
import Icon from "./Icon.astro";
import { useT, pathFor, type Lang } from "../i18n/ui";
import { formatDate, readingMinutes, slugOf } from "../lib/blog";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);

const posts = (
  await getCollection("blog", ({ id, data }) => id.startsWith(`${lang}/`) && !data.draft)
).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout
  lang={lang}
  title={t("blogPageTitle")}
  description={t("blogPageDesc")}
  alternates={{ id: "/blog/", en: "/en/blog/" }}
>
  <main id="main">
    <PageHeader
      tag={t("bpTag")}
      title={t("bpTitleA")}
      highlight={t("bpTitleHl")}
      intro={t("bpIntro")}
      art="stones"
    />

    <section class="pb-16 pt-8 sm:pb-24">
      <Container>
        {posts.length === 0 ? (
          <p class="rounded-2xl border border-mist-200 bg-white p-6 text-muted">{t("blogEmpty")}</p>
        ) : (
          <ul data-stagger="120" class="lift-children grid gap-5 md:grid-cols-2 lg:grid-cols-3">
            {posts.map((p) => (
              <li>
                <a
                  href={pathFor(lang, `/blog/${slugOf(p.id)}/`)}
                  class="group flex h-full flex-col justify-between rounded-[1.75rem] border border-mist-200 bg-white p-6 transition hover:border-forest-700"
                >
                  <div>
                    <p class="text-sm text-muted">
                      {formatDate(p.data.date, lang)} &middot; {readingMinutes(p.body)} {t("minRead")}
                    </p>
                    <h2 class="mt-3 text-2xl font-semibold leading-snug">{p.data.title}</h2>
                    <p class="mt-3 text-muted">{p.data.description}</p>
                  </div>
                  <span class="mt-6 inline-flex items-center gap-3 font-semibold text-forest-800">
                    {t("readMore")}
                    <span class="grid h-10 w-10 place-items-center rounded-full bg-leaf-400 text-forest-900 transition group-hover:translate-x-1">
                      <Icon name="arrow" />
                    </span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        )}
      </Container>
    </section>
  </main>
</BaseLayout>