---
import { getCollection } from "astro:content";
import type { ImageMetadata } from "astro";
import Container from "./Container.astro";
import Tag from "./Tag.astro";
import Button from "./Button.astro";
import Icon from "./Icon.astro";
import Photo from "./Photo.astro";
import { useT, type Lang } from "../i18n/ui";
import { site, rating, waLink } from "../config/site";
import { rupiah } from "../lib/format";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);

const layanan = await getCollection("layanan");
const first = layanan[0]?.data;
const eta = site.eta[lang];

const heroFiles = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/hero.{jpg,jpeg,png,webp}",
  { eager: true },
);
const hero = Object.values(heroFiles)[0]?.default;

// PNG dianggap foto cutout (latar transparan). Kalau PNG Anda berlatar penuh,
// ganti baris ini menjadi: const cutout = false;
const cutout = hero?.format === "png";

const chips = [t("chipSurf"), t("chipCouple"), t("chipVilla"), `${t("arrival")} ${eta}`];

const split = (text: string) => text.split(" ");
const firstWords = split(t("heroTitleA"));
const hlWords = split(t("heroTitleHl"));
---

<section data-parallax class="relative overflow-x-clip py-10 sm:py-16">
  <Container class="grid items-center gap-12 lg:grid-cols-2 lg:gap-14">
    <div class="relative z-10">
      <div class="hero-rise" style="--d:0ms">
        <Tag tone="lime">{t("heroTag")}</Tag>
      </div>

      <h1 class="hero-title mt-5 font-semibold">
        {firstWords.map((w, i) => (
          <>
            <span class="hero-word"><span style={`--i:${i}`}>{w}</span></span>{" "}
          </>
        ))}
        <span class="hl">
          {hlWords.map((w, i) => (
            <>
              <span class="hero-word"><span style={`--i:${i + firstWords.length}`}>{w}</span></span>{" "}
            </>
          ))}
        </span>
      </h1>

      <p class="hero-rise mt-4 max-w-lg text-lg text-muted" style="--d:700ms">{t("heroDesc")}</p>

      <div class="hero-rise mt-7 flex flex-wrap items-center gap-5" style="--d:850ms">
        <Button href={waLink(t("waMessage"))} variant="lime" size="lg" external>
          <Icon name="chat" /> {t("bookWa")}
        </Button>
        <a href="#layanan" class="inline-flex items-center gap-3 font-semibold text-forest-800">
          <span class="grid h-12 w-12 place-items-center rounded-full bg-forest-900 text-leaf-400">
            <Icon name="arrow" />
          </span>
          {t("seeServices")}
        </a>
      </div>

      <ul class="hero-rise mt-6 flex flex-wrap gap-2 border-t border-forest-900/15 pt-5" style="--d:1000ms">
        {chips.map((c) => (
          <li class="rounded-full border border-forest-900/25 px-3 py-1 text-sm">{c}</li>
        ))}
      </ul>
    </div>

    <div class="relative mx-auto w-full max-w-xs sm:max-w-sm lg:max-w-md">
      <!-- Riak air: tetesan jatuh dari atas, cincin menyebar (dekoratif) -->
      <div class="ripple-stage" aria-hidden="true">
        
        <span class="ripple-ring" style="--r:0"></span>
        <span class="ripple-ring" style="--r:1"></span>
        <span class="ripple-ring" style="--r:2"></span>
        <!-- <span class="ripple-ring" style="--r:3"></span> -->
        <!-- <span class="ripple-drop"></span> -->
      </div>

            <!-- {/* Foto utama: PNG transparan tampil utuh (cutout), selain itu di bingkai membulat */} -->
      {cutout ? (
        <div
          class="hero-rise parallax-soft relative z-10 h-[18rem] sm:h-[22rem] lg:h-[26rem]"
          style="--d:300ms"
        >
          <Photo
            src={hero}
            alt={t("heroAlt")}
            label="Foto hero"
            fill
            contain
            eager
            position="center bottom"
            class="drop-shadow-2xl"
            sizes="(min-width: 1024px) 512px, 100vw"
          />
        </div>
      ) : (
        <div class="hero-photo relative z-10 aspect-[4/3] overflow-hidden rounded-[2rem] shadow-xl lg:aspect-[4/5] lg:max-h-[34rem]">
          <div class="parallax-photo absolute inset-0">
            <Photo
              src={hero}
              alt={t("heroAlt")}
              label="Foto hero"
              fill
              eager
              position="center 30%"
              sizes="(min-width: 1024px) 512px, 100vw"
            />
          </div>
        </div>
      )}

      <!-- Kartu booking (ilustrasi, bukan data pesanan nyata) -->
      <div
        aria-hidden="true"
        class="hero-rise parallax-fast absolute -bottom-6 -left-3 z-20 sm:-left-10"
        style="--d:1100ms"
      >
        <div class="float-slow w-64 rounded-2xl bg-forest-900 p-4 text-white shadow-2xl">
          <p class="text-xs font-semibold uppercase tracking-wider text-leaf-400">{t("heroCardLabel")}</p>
          {first && <p class="mt-1 font-semibold">{first.title[lang]}</p>}
          {first && (
            <p class="text-sm text-white/70">
              {first.duration} {t("minutes")} · {rupiah(first.price)}
            </p>
          )}
          <div class="mt-3 flex items-center gap-2 rounded-xl bg-white/10 px-3 py-2 text-sm">
            <span class="relative flex h-2.5 w-2.5">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-leaf-400 opacity-75 motion-reduce:animate-none"></span>
              <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-leaf-400"></span>
            </span>
            {t("heroCardStatus")}
          </div>
        </div>
      </div>

      {rating && (
        <div class="hero-rise parallax-fast absolute -right-2 top-8 z-20 sm:-right-8" style="--d:1300ms">
          <div class="float-slower flex items-center gap-2 rounded-2xl bg-white px-4 py-3 shadow-xl">
            <Icon name="star" filled class="text-amber-500" />
            <div class="leading-tight">
              <p class="font-bold">{rating.score.toFixed(1)}</p>
              <p class="text-xs text-muted">{rating.count} Google</p>
            </div>
          </div>
        </div>
      )}
    </div>
  </Container>
</section>