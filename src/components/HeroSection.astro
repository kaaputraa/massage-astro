---
import { getCollection } from "astro:content";
import hero from "../assets/hero.jpg";
import Container from "./Container.astro";
import Tag from "./Tag.astro";
import Button from "./Button.astro";
import Icon from "./Icon.astro";
import Photo from "./Photo.astro";
import { useT, type Lang } from "../i18n/ui";
import { site, rating, waLink } from "../config/site";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);

const layanan = await getCollection("layanan");
const first = layanan[0]?.data;
const eta = site.eta[lang];
const heroFrame = "aspect-[4/3] lg:aspect-[5/4]";

const rupiah = (n: number) =>
  new Intl.NumberFormat("id-ID", {
    style: "currency",
    currency: "IDR",
    maximumFractionDigits: 0,
  }).format(n);

const chips = [t("chipSurf"), t("chipCouple"), t("chipVilla"), `${t("arrival")} ${eta}`];
---

<section class="relative overflow-hidden pb-20 pt-10 sm:pt-16">
  <Container class="grid items-center gap-14 lg:grid-cols-2">
    <div>
      <Tag tone="lime">{t("heroTag")}</Tag>
      <h1 class="mt-5 text-5xl font-semibold leading-[1.05] sm:text-6xl">
        {t("heroTitleA")} <span class="hl">{t("heroTitleHl")}</span>
      </h1>
      <p class="mt-5 max-w-lg text-lg text-muted">{t("heroDesc")}</p>

      <div class="mt-8 flex flex-wrap items-center gap-5">
        <Button href={waLink(t("waMessage"))} variant="lime" size="lg" external>
          <Icon name="chat" /> {t("bookWa")}
        </Button>
        <a href="#layanan" class="inline-flex items-center gap-3 font-semibold text-forest-800">
          <span class="grid h-12 w-12 place-items-center rounded-full bg-forest-900 text-leaf-400">
            <Icon name="arrow" />
          </span>
          {t("seeServices")}
        </a>
      </div>

      <ul class="mt-8 flex flex-wrap gap-2 border-t border-forest-900/15 pt-6">
        {chips.map((c) => (
          <li class="rounded-full border border-forest-900/25 px-3 py-1 text-sm">{c}</li>
        ))}
      </ul>
    </div>

    <div class="relative mx-auto w-full max-w-md lg:max-w-lg">
      <div class="absolute -inset-5 rounded-full border border-leaf-400" aria-hidden="true"></div>

      <div class:list={["relative overflow-hidden rounded-[2rem] shadow-xl", heroFrame]}>
        <Photo
            src={hero}
            alt={t("heroAlt")}
            label="Foto hero"
            fill
            eager
            position="center 30%"
            sizes="(min-width: 1024px) 512px, 100vw"
        />
        </div>

      <!-- Kartu booking (ilustrasi, bukan data pesanan nyata) -->
      <div
        aria-hidden="true"
        class="absolute -bottom-6 -left-3 w-64 rounded-2xl bg-forest-900 p-4 text-white shadow-2xl sm:-left-10"
      >
        <p class="text-xs font-semibold uppercase tracking-wider text-leaf-400">{t("heroCardLabel")}</p>
        {first && <p class="mt-1 font-semibold">{first.title[lang]}</p>}
        {first && (
          <p class="text-sm text-white/70">
            {first.duration} {t("minutes")} · {rupiah(first.price)}
          </p>
        )}
        <div class="mt-3 flex items-center gap-2 rounded-xl bg-white/10 px-3 py-2 text-sm">
          <span class="relative flex h-2.5 w-2.5">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-leaf-400 opacity-75 motion-reduce:animate-none"></span>
            <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-leaf-400"></span>
          </span>
          {t("heroCardStatus")}
        </div>
      </div>

      {rating && (
        <div class="absolute -right-2 top-8 flex items-center gap-2 rounded-2xl bg-white px-4 py-3 shadow-xl sm:-right-8">
          <Icon name="star" filled class="text-amber-500" />
          <div class="leading-tight">
            <p class="font-bold">{rating.score.toFixed(1)}</p>
            <p class="text-xs text-muted">{rating.count} Google</p>
          </div>
        </div>
      )}
    </div>
  </Container>
</section>