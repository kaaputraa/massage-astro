---
import type { ImageMetadata } from "astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "./PageHeader.astro";
import Container from "./Container.astro";
import Tag from "./Tag.astro";
import Section from "./Section.astro";
import Icon from "./Icon.astro";
import Photo from "./Photo.astro";
import CtaBanner from "./CtaBanner.astro";
import { useT, type Lang } from "../i18n/ui";
import { team } from "../config/site";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);

const storyFiles = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/tentang.{jpg,jpeg,png,webp}",
  { eager: true },
);
const storyPhoto = Object.values(storyFiles)[0]?.default;

const teamFiles = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/team/*.{jpg,jpeg,png,webp}",
  { eager: true },
);
const teamPhoto = (slug: string) =>
  Object.entries(teamFiles).find(
    ([path]) => /\/([^/]+)\.[a-z]+$/.exec(path)?.[1] === slug,
  )?.[1].default;

const values = [
  { icon: "sparkle", title: t("v1Title"), desc: t("v1Desc") },
  { icon: "clock", title: t("v2Title"), desc: t("v2Desc") },
  { icon: "check", title: t("v3Title"), desc: t("v3Desc") },
  { icon: "star", title: t("v4Title"), desc: t("v4Desc") },
] as const;

const steps = [
  { title: t("std1Title"), desc: t("std1Desc") },
  { title: t("std2Title"), desc: t("std2Desc") },
  { title: t("std3Title"), desc: t("std3Desc") },
  { title: t("std4Title"), desc: t("std4Desc") },
];
---

<BaseLayout
  lang={lang}
  title={t("aboutPageTitle")}
  description={t("aboutPageDesc")}
  alternates={{ id: "/tentang/", en: "/en/about/" }}
>
  <main id="main">
    <PageHeader
      tag={t("apTag")}
      title={t("apTitleA")}
      highlight={t("apTitleHl")}
      intro={t("apIntro")}
      art="leaf"
    />

    <!-- Cerita -->
    <section class="py-12 sm:py-16">
      <Container class="grid items-center gap-14 lg:grid-cols-2">
        <div class="relative mx-auto w-full max-w-md lg:max-w-none">
          <div class="absolute -right-4 -top-4 h-full w-full rounded-[2rem] bg-leaf-400" aria-hidden="true"></div>
          <div data-reveal="clip" class="relative aspect-[4/5] overflow-hidden rounded-[2rem] shadow-xl">
            <Photo
              src={storyPhoto}
              alt={t("storyPhotoAlt")}
              label="Foto cerita bisnis"
              fill
              position="center 30%"
            />
          </div>
        </div>

        <div data-stagger="120">
          <h2 class="mt-4 text-3xl font-semibold leading-tight sm:text-5xl">
            {t("storyTitleA")} <span class="hl">{t("storyTitleHl")}</span>
          </h2>
          <p class="mt-5 text-lg text-muted">{t("storyP1")}</p>
          <p class="mt-4 text-lg text-muted">{t("storyP2")}</p>
        </div>
      </Container>
    </section>

    <!-- Nilai -->
    <Section tag={t("valuesTag")} title={t("valuesTitleA")} highlight={t("valuesTitleHl")}>
      <ul data-stagger="110" class="lift-children grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {values.map((v, i) => (
          <li
            class:list={[
              "rounded-[1.75rem] p-6",
              i === 0 ? "bg-leaf-400 text-forest-900" : "border border-mist-200 bg-white",
            ]}
          >
            <span
              class:list={[
                "grid h-12 w-12 place-items-center rounded-full",
                i === 0 ? "bg-forest-900 text-leaf-400" : "bg-leaf-100 text-forest-800",
              ]}
            >
              <Icon name={v.icon} />
            </span>
            <h3 class="mt-5 text-xl font-semibold">{v.title}</h3>
            <p class:list={["mt-2 text-sm", i === 0 ? "text-forest-900/80" : "text-muted"]}>{v.desc}</p>
          </li>
        ))}
      </ul>
    </Section>

    <!-- Standar layanan -->
