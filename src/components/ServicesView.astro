---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "./PageHeader.astro";
import Container from "./Container.astro";
import Icon from "./Icon.astro";
import ServicePlan from "./ServicePlan.astro";
import ServicePicker from "./ServicePicker.astro";
import { useT, type Lang } from "../i18n/ui";
import { site, waLink } from "../config/site";
import Section from "./Section.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);

const layanan = await getCollection("layanan");
const areaList = await getCollection("area");

const tones = ["forest", "lime", "mist"] as const;
const arts = ["lotus", "stones", "wave", "leaf"] as const;

const areas = areaList.map((a) => a.data.nama).join(", ");
const notes = [
  { icon: "wallet", text: t("notePay") },
  { icon: "clock", text: t("noteArrival", { eta: site.eta[lang] }) },
  { icon: "pin", text: t("noteAreas", { areas }) },
] as const;
---

<BaseLayout
  lang={lang}
  title={t("servicesPageTitle")}
  description={t("servicesPageDesc")}
  alternates={{ id: "/layanan/", en: "/en/services/" }}
>
  <main id="main">
    <PageHeader
      tag={t("spTag")}
      title={t("spTitleA")}
      highlight={t("spTitleHl")}
      intro={t("spIntro")}
      art="lotus"
    />

    <!-- Kartu layanan: sama tinggi, berdampingan -->
    <section class="pb-5 pt-6 sm:pt-8">
      <Container>
          <div data-stagger="120" class="lift-children grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {layanan.map((l, i) => (
            <ServicePlan
              title={l.data.title[lang]}
              price={l.data.price}
              duration={l.data.duration}
              description={l.data.description[lang]}
              minutesLabel={t("minutes")}
              benefits={l.data.benefits?.[lang]}
              bestFor={l.data.bestFor?.[lang]}
              bestForLabel={t("suitableFor")}
              href={waLink(t("waMessageService", { service: l.data.title[lang] }))}
              cta={t("bookService", { service: l.data.title[lang] })}
              tone={tones[i % tones.length]}
              art={arts[i % arts.length]}
            />
          ))}
        </div>
      </Container>
    </section>

        <!-- Info penting -->
    <Section tight tag={t("notesTag")} title={t("notesTitleA")} highlight={t("notesTitleHl")}>
        <ul data-stagger="120" class="lift-children grid gap-4 md:grid-cols-3">
        {notes.map((n) => (
          <li class="flex items-start gap-4 rounded-3xl border border-mist-200 bg-white p-5">
            <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-leaf-100 text-forest-800">
              <Icon name={n.icon} />
            </span>
            <span class="pt-2 text-sm font-medium leading-snug">{n.text}</span>
          </li>
        ))}
      </ul>
    </Section>

    <!-- Pemilih pesanan -->
    <!-- <ServicePicker lang={lang} /> -->
  </main>
</BaseLayout>