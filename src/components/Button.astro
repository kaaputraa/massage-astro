---
interface Props {
  href: string;
  variant?: "primary" | "secondary" | "whatsapp";
  size?: "sm" | "md" | "lg";
  external?: boolean;
  class?: string;
}

const {
  href,
  variant = "primary",
  size = "md",
  external = false,
  class: className,
} = Astro.props;

const base =
  "inline-flex items-center justify-center gap-2 rounded-full font-semibold transition";
const variants = {
  primary: "bg-forest-700 text-white hover:bg-forest-800",
  secondary: "border border-forest-700 text-forest-800 hover:bg-forest-50",
  whatsapp: "bg-[#0b7a3e] text-white hover:bg-[#096732]",
};
const sizes = {
  sm: "px-4 py-2 text-sm",
  md: "px-6 py-3 text-base",
  lg: "px-8 py-4 text-lg",
};
---

<a
  href={href}
  class:list={[base, variants[variant], sizes[size], className]}
  {...(external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
>
  <slot />
</a>