---
interface Props {
  title: string;
  price: number;
  duration: number;
  description: string;
  minutesLabel?: string;
}

const { title, price, duration, description, minutesLabel = "menit" } = Astro.props;

const rupiah = new Intl.NumberFormat("id-ID", {
  style: "currency",
  currency: "IDR",
  maximumFractionDigits: 0,
}).format(price);
---

<article class="rounded-2xl border border-sand-200 bg-white p-6 shadow-sm">
  <h3 class="text-lg font-semibold">{title}</h3>
  <p class="mt-1 text-sm text-muted">{duration} {minutesLabel}</p>
  <p class="mt-3 text-ink/80">{description}</p>
  <p class="mt-4 text-xl font-bold text-forest-700">{rupiah}</p>
</article>