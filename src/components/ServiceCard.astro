---
import ServiceArt from "./ServiceArt.astro";
import Icon from "./Icon.astro";

interface Props {
  title: string;
  price: number;
  duration: number;
  description: string;
  minutesLabel?: string;
  tone?: "forest" | "lime" | "mist" | "white";
  art?: "lotus" | "stones" | "wave" | "leaf";
  href?: string;
  ctaLabel?: string;
}

const {
  title,
  price,
  duration,
  description,
  minutesLabel = "menit",
  tone = "white",
  art = "leaf",
  href,
  ctaLabel = title,
} = Astro.props;

const rupiah = new Intl.NumberFormat("id-ID", {
  style: "currency",
  currency: "IDR",
  maximumFractionDigits: 0,
}).format(price);

const styles = {
  forest: {
    card: "bg-forest-800 text-white",
    art: "text-leaf-400/20",
    chip: "bg-white/10 text-white",
    btn: "bg-leaf-400 text-forest-900 hover:bg-leaf-300",
    sub: "text-white/75",
  },
  lime: {
    card: "bg-leaf-400 text-forest-900",
    art: "text-forest-900/10",
    chip: "bg-forest-900/10 text-forest-900",
    btn: "bg-forest-900 text-leaf-400 hover:bg-forest-800",
    sub: "text-forest-900/80",
  },
  mist: {
    card: "bg-leaf-100 text-forest-900",
    art: "text-forest-700/10",
    chip: "bg-forest-900/10 text-forest-900",
    btn: "bg-forest-800 text-white hover:bg-forest-900",
    sub: "text-forest-900/80",
  },
  white: {
    card: "bg-white text-forest-900 border border-mist-200",
    art: "text-forest-700/10",
    chip: "bg-mist-100 text-forest-900",
    btn: "bg-forest-800 text-white hover:bg-forest-900",
    sub: "text-forest-900/75",
  },
}[tone];
---

<article
  class:list={[
    "relative flex min-h-[22rem] flex-col justify-between overflow-hidden rounded-[1.75rem] p-6",
    styles.card,
  ]}
>
  <ServiceArt
    kind={art}
    class:list={["pointer-events-none absolute -right-8 -top-6 h-56 w-56", styles.art]}
  />

  <div class="relative">
    <span class:list={["inline-flex rounded-full px-3 py-1 text-xs font-semibold", styles.chip]}>
      {duration} {minutesLabel}
    </span>
  </div>

  <div class="relative">
    <h3 class="text-2xl font-semibold leading-tight">{title}</h3>
    <p class:list={["mt-2 text-sm", styles.sub]}>{description}</p>
    <div class="mt-5 flex items-end justify-between gap-3">
      <p class="text-2xl font-bold">{rupiah}</p>
      {href && (
        <a
          href={href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={ctaLabel}
          class:list={["grid h-11 w-11 shrink-0 place-items-center rounded-full transition", styles.btn]}
        >
          <Icon name="arrow" />
        </a>
      )}
    </div>
  </div>
</article>