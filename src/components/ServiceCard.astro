---
interface Props {
  title: string;
  price: number;
  duration: number;
}

const { title, price, duration } = Astro.props;

const rupiah = new Intl.NumberFormat("id-ID", {
  style: "currency",
  currency: "IDR",
  maximumFractionDigits: 0,
}).format(price);
---

<article class="rounded-2xl border border-stone-200 bg-white p-6 shadow-sm">
  <h3 class="text-lg font-semibold">{title}</h3>
  <p class="mt-1 text-sm text-stone-600">{duration} menit</p>
  <p class="mt-3 text-xl font-bold text-emerald-700">{rupiah}</p>
</article>