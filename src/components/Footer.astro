---
import WhatsAppButton from "./WhatsAppButton.astro";
const tahun = new Date().getFullYear();
---

<footer class="mt-20 border-t border-stone-200 bg-white">
  <div class="mx-auto max-w-5xl px-4 py-10 text-center">
    <p class="font-semibold">Massage Canggu</p>
    <p class="mt-1 text-sm text-stone-600">
      Melayani Canggu, Berawa, Batu Bolong, Echo Beach, dan Pererenan.
    </p>
    <div class="mt-4"><WhatsAppButton /></div>
    <p class="mt-6 text-xs text-stone-500">&copy; {tahun} Massage Canggu</p>
  </div>
</footer>