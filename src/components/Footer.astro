---
import { getCollection } from "astro:content";
import Container from "./Container.astro";
import Button from "./Button.astro";
import { useT, route, pathFor, type Lang } from "../i18n/ui";
import { site, waLink } from "../config/site";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useT(lang);
const areas = await getCollection("area");
const year = new Date().getFullYear();

const links = [
  { label: t("home"), href: route(lang, "home") },
  { label: t("navServices"), href: route(lang, "services") },
  { label: t("navAbout"), href: route(lang, "about") },
  { label: t("navBlog"), href: route(lang, "blog") },
  { label: t("navContact"), href: route(lang, "contact") },
];
---

<footer class="bg-forest-900 text-sand-100">
  <Container class="grid gap-10 py-14 md:grid-cols-4">
    <div class="md:col-span-2">
      <p class="font-display text-2xl font-semibold">{site.name}</p>
      <p class="mt-3 max-w-md text-sand-200">{t("footerTagline")}</p>
      <div class="mt-5">
        <Button href={waLink(t("waMessage"))} variant="whatsapp" external>{t("bookWa")}</Button>
      </div>
    </div>

    <nav aria-label="Footer">
      <p class="font-semibold">{t("footerMenu")}</p>
      <ul class="mt-3 space-y-2 text-sm text-sand-200">
        {links.map((l) => (
          <li><a href={l.href} class="hover:underline">{l.label}</a></li>
        ))}
      </ul>
    </nav>

    <div>
      <p class="font-semibold">{t("footerAreaTitle")}</p>
      <ul class="mt-3 space-y-2 text-sm text-sand-200">
        {areas.map((a) => (
          <li>
            <a href={pathFor(lang, `/area/${a.id}/`)} class="hover:underline">
              {t("massageIn", { area: a.data.nama })}
            </a>
          </li>
        ))}
      </ul>
      <p class="mt-5 font-semibold">{t("footerHours")}</p>
      <p class="mt-2 text-sm text-sand-200">{site.hours[lang]}</p>
    </div>
  </Container>

  <div class="border-t border-white/10 py-5 text-center text-xs text-sand-200">
    &copy; {year} {site.name} &middot;
    <a href={route(lang, "privacy")} class="underline">{t("navPrivacy")}</a>
  </div>
</footer>