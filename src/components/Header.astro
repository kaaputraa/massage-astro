---
import Container from "./Container.astro";
import Button from "./Button.astro";
import { useT, route, type Lang } from "../i18n/ui";
import { site, waLink } from "../config/site";

interface Props {
  lang: Lang;
  alternates?: { id: string; en: string };
}

const { lang, alternates } = Astro.props;
const t = useT(lang);
const current = Astro.url.pathname;

const nav = [
  { key: "navServices", href: route(lang, "services") },
  { key: "navAbout", href: route(lang, "about") },
  { key: "navBlog", href: route(lang, "blog") },
  { key: "navContact", href: route(lang, "contact") },
] as const;
---

<a
  href="#main"
  class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-lg focus:bg-white focus:px-4 focus:py-2"
>
  {t("skip")}
</a>

<header class="sticky top-0 z-40 border-b border-sand-200/70 bg-sand-50/90 backdrop-blur">
  <Container class="flex h-16 items-center justify-between gap-4">
    <a href={route(lang, "home")} class="font-display text-xl font-semibold text-forest-800">
      {site.name}
    </a>

    <nav aria-label="Main" class="hidden items-center gap-7 md:flex">
      {nav.map((item) => (
        <a
          href={item.href}
          aria-current={current.startsWith(item.href) ? "page" : undefined}
          class="text-sm font-medium text-ink/80 underline-offset-8 hover:text-forest-700 aria-[current=page]:text-forest-700 aria-[current=page]:underline"
        >
          {t(item.key)}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      {alternates && (
        <div class="flex items-center gap-1 text-sm" role="group" aria-label="Language">
          <a
            href={alternates.id}
            lang="id"
            hreflang="id"
            aria-current={lang === "id" ? "true" : undefined}
            class="rounded px-2 py-1 hover:bg-sand-100 aria-[current=true]:bg-forest-700 aria-[current=true]:text-white"
          >ID</a>
          <a
            href={alternates.en}
            lang="en"
            hreflang="en"
            aria-current={lang === "en" ? "true" : undefined}
            class="rounded px-2 py-1 hover:bg-sand-100 aria-[current=true]:bg-forest-700 aria-[current=true]:text-white"
          >EN</a>
        </div>
      )}

      <Button href={waLink(t("waMessage"))} variant="whatsapp" size="sm" external class="hidden sm:inline-flex">
        {t("bookWa")}
      </Button>

      <details class="relative md:hidden">
        <summary class="flex h-10 cursor-pointer list-none items-center rounded-lg border border-sand-300 px-3 text-sm font-medium [&::-webkit-details-marker]:hidden">
          {t("menu")}
        </summary>
        <nav aria-label="Mobile" class="absolute right-0 mt-2 w-56 rounded-xl border border-sand-200 bg-white p-2 shadow-lg">
          {nav.map((item) => (
            <a href={item.href} class="block rounded-lg px-3 py-2 text-sm font-medium hover:bg-sand-100">
              {t(item.key)}
            </a>
          ))}
        </nav>
      </details>
    </div>
  </Container>
</header>