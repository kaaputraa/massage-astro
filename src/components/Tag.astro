---
interface Props {
  tone?: "dark" | "light" | "lime";
  class?: string;
}

const { tone = "dark", class: className } = Astro.props;
const tones = {
  dark: "bg-forest-900 text-white",
  light: "border border-mist-200 bg-white text-forest-800",
  lime: "bg-leaf-400 text-forest-900",
};
---

<span
  class:list={[
    "inline-flex items-center rounded-full px-4 py-1.5 text-sm font-semibold",
    tones[tone],
    className,
  ]}
>
  <slot />
</span>