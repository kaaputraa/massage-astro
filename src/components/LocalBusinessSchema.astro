  telephone: "+62812xxxxxxx",
  priceRange: "Rp150.000 - Rp250.000",
  description: "Massage panggilan ke villa dan hotel di Canggu.",
  areaServed: ["Canggu", "Berawa", "Echo Beach", "Batu Bolong", "Pererenan"],
