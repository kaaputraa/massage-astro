---
import { useT, type Lang } from "../i18n/ui";
import { waLink } from "../config/site";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
---

<a
  href={waLink(t("waMessage"))}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={t("bookWa")}
  class="fixed bottom-4 right-4 z-50 flex h-14 w-14 items-center justify-center rounded-full bg-[#0b7a3e] text-white shadow-lg transition hover:scale-105 hover:bg-[#096732] sm:bottom-6 sm:right-6"
  style="margin-bottom: env(safe-area-inset-bottom, 0px)"
>
  <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor"
       stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z" />
  </svg>
</a>