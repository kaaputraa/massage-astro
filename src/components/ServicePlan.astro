---
import ServiceArt from "./ServiceArt.astro";
import Icon from "./Icon.astro";
import Button from "./Button.astro";
import { rupiah } from "../lib/format";

interface Props {
  title: string;
  price: number;
  duration: number;
  description: string;
  minutesLabel: string;
  benefits?: string[];
  bestFor?: string;
  bestForLabel: string;
  href: string;
  cta: string;
  tone?: "forest" | "lime" | "mist";
  art?: "lotus" | "stones" | "wave" | "leaf";
}

const {
  title,
  price,
  duration,
  description,
  minutesLabel,
  benefits = [],
  bestFor,
  bestForLabel,
  href,
  cta,
  tone = "forest",
  art = "leaf",
} = Astro.props;

const bands = {
  forest: { band: "bg-forest-800 text-white", art: "text-leaf-400/20", chip: "bg-white/10" },
  lime: { band: "bg-leaf-400 text-forest-900", art: "text-forest-900/10", chip: "bg-forest-900/10" },
  mist: { band: "bg-leaf-100 text-forest-900", art: "text-forest-700/10", chip: "bg-forest-900/10" },
}[tone];
---

<article class="flex h-full flex-col overflow-hidden rounded-[1.75rem] border border-mist-200 bg-white">
  <div class:list={["relative flex h-36 flex-col justify-between overflow-hidden p-5", bands.band]}>
    <ServiceArt
      kind={art}
      class:list={["pointer-events-none absolute -right-8 -top-8 h-48 w-48", bands.art]}
    />
    <span class:list={["relative inline-flex w-fit rounded-full px-3 py-1 text-xs font-semibold", bands.chip]}>
      {duration} {minutesLabel}
    </span>
    <p class="relative font-display text-3xl font-bold">{rupiah(price)}</p>
  </div>

  <div class="flex flex-1 flex-col p-5">
    <h3 class="text-xl font-semibold">{title}</h3>
    <p class="mt-1 text-sm text-muted">{description}</p>

    {benefits.length > 0 && (
      <ul class="mt-4 space-y-2">
        {benefits.map((b) => (
          <li class="flex items-start gap-3 text-sm">
            <span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-leaf-100 text-forest-800">
              <Icon name="check" size={12} />
            </span>
            {b}
          </li>
        ))}
      </ul>
    )}

    {bestFor && (
      <p class="mt-4 rounded-xl bg-mist-100 px-3 py-2 text-sm">
        <span class="font-semibold">{bestForLabel}:</span> {bestFor}
      </p>
    )}

    <div class="mt-auto pt-5">
      <Button href={href} variant="dark" external class="w-full">
        {cta} <Icon name="arrow" size={18} />
      </Button>
    </div>
  </div>
</article>