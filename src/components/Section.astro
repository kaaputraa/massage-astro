---
import Container from "./Container.astro";
import Tag from "./Tag.astro";

interface Props {
  id?: string;
  tag?: string;
  title?: string;
  highlight?: string;
  aside?: string;
  tight?: boolean;
  class?: string;
}

const { id, tag, title, highlight, aside, tight = false, class: className } = Astro.props;
---

<section id={id} class:list={[tight ? "py-10 sm:py-14" : "py-16 sm:py-24", className]}>
  <Container>
    {(tag || title) && (
      <header
        class:list={[
          "flex flex-col gap-4 md:flex-row md:items-end md:justify-between",
          tight ? "mb-6" : "mb-10",
        ]}
      >
        <div class="max-w-2xl">
          {tag && <Tag tone="dark">{tag}</Tag>}
          {title && (
            <h2
              class:list={[
                "mt-4 font-semibold leading-tight",
                tight ? "text-2xl sm:text-4xl" : "text-3xl sm:text-5xl",
              ]}
            >
              {title} {highlight && <span class="hl">{highlight}</span>}
            </h2>
          )}
        </div>
        {aside && <p class="max-w-xs text-sm text-muted md:text-right">{aside}</p>}
      </header>
    )}
    <slot />
  </Container>
</section>