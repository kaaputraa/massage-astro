---
import Container from "./Container.astro";
import Tag from "./Tag.astro";

interface Props {
  id?: string;
  tag?: string;
  title?: string;
  highlight?: string;
  aside?: string;
  class?: string;
}

const { id, tag, title, highlight, aside, class: className } = Astro.props;
---

<section id={id} class:list={["py-16 sm:py-24", className]}>
  <Container>
    {(tag || title) && (
      <header class="mb-10 flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <div class="max-w-2xl">
          {tag && <Tag tone="dark">{tag}</Tag>}
          {title && (
            <h2 class="mt-4 text-3xl font-semibold leading-tight sm:text-5xl">
              {title} {highlight && <span class="hl">{highlight}</span>}
            </h2>
          )}
        </div>
        {aside && <p class="max-w-xs text-sm text-muted md:text-right">{aside}</p>}
      </header>
    )}
    <slot />
  </Container>
</section>