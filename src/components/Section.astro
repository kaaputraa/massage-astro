---
import Container from "./Container.astro";

interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  tone?: "default" | "sand";
  class?: string;
}

const { id, eyebrow, title, subtitle, tone = "default", class: className } = Astro.props;
const tones = { default: "", sand: "bg-sand-100" };
---

<section id={id} class:list={["py-16 sm:py-20", tones[tone], className]}>
  <Container>
    {(eyebrow || title) && (
      <header class="mx-auto mb-10 max-w-2xl text-center">
        {eyebrow && (
          <p class="text-sm font-semibold uppercase tracking-widest text-clay-600">{eyebrow}</p>
        )}
        {title && <h2 class="mt-2 text-3xl font-semibold sm:text-4xl">{title}</h2>}
        {subtitle && <p class="mt-3 text-muted">{subtitle}</p>}
      </header>
    )}
    <slot />
  </Container>
</section>