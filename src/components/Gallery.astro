---
import type { ImageMetadata } from "astro";
import Section from "./Section.astro";
import Photo from "./Photo.astro";
import { useT, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);

// Foto opsional: taruh di src/assets/gallery/ (jpg, jpeg, png, webp), maksimal 5 dipakai
const files = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/gallery/*.{jpg,jpeg,png,webp}",
  { eager: true },
);
const photos = Object.entries(files)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, m]) => m.default)
  .slice(0, 5);

const tiles = Array.from({ length: 5 }, (_, i) => photos[i]);
---

<Section tag={t("galleryTag")} title={t("galleryTitleA")} highlight={t("galleryTitleHl")}>
  <div class="grid grid-cols-2 gap-3 md:grid-cols-4">
    {tiles.map((src, i) => (
      <div
        class:list={[
          "relative overflow-hidden rounded-2xl",
          i === 0 ? "col-span-2 aspect-[16/10] md:row-span-2 md:aspect-auto" : "aspect-square",
        ]}
      >
        <Photo
          src={src}
          alt={`${t("galleryAlt")} ${i + 1}`}
          label="Foto galeri"
          fill
          sizes="(min-width: 768px) 33vw, 50vw"
        />
      </div>
    ))}
  </div>
</Section>