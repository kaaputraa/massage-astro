---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSection from "./HeroSection.astro";
import TrustStrip from "./TrustStrip.astro";
import HowItWorks from "./HowItWorks.astro";
import Gallery from "./Gallery.astro";
import Testimonials from "./Testimonials.astro";
import Section from "./Section.astro";
import Photo from "./Photo.astro";
import Icon from "./Icon.astro";
import ServiceCard from "./ServiceCard.astro";
import FaqItem from "./FaqItem.astro";
import LocalBusinessSchema from "./LocalBusinessSchema.astro";
import { useT, pathFor, type Lang } from "../i18n/ui";
import { waLink, testimonials } from "../config/site";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);

const layanan = await getCollection("layanan");
const faq = await getCollection("faq");
const areaList = await getCollection("area");

const tones = ["forest", "lime", "mist", "white"] as const;
const arts = ["lotus", "stones", "wave", "leaf"] as const;

---

<BaseLayout
  lang={lang}
  title={t("homeTitle")}
  description={t("homeDesc")}
  alternates={{ id: "/", en: "/en/" }}
>
  <LocalBusinessSchema slot="head" />

  
  <main id="main">
    <div id="s-top" data-section>
      <HeroSection lang={lang} />
      <TrustStrip lang={lang} />
    </div>

    <div id="s-layanan" data-section>
      <Section
        id="layanan"
        tag={t("services")}
        title={t("servicesTitleA")}
        highlight={t("servicesTitleHl")}
        aside={t("servicesAside")}
      >
        <div data-stagger="100" class="lift-children grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          <div
            data-reveal="left"
            class="relative min-h-[clamp(14rem,34vh,22rem)] overflow-hidden rounded-[1.75rem]"
          >
            <Photo alt={t("photoSessionAlt")} label="Foto sesi massage di villa" fill />
          </div>

          {layanan.map((l, i) => (
            <ServiceCard
              title={l.data.title[lang]}
              price={l.data.price}
              duration={l.data.duration}
              description={l.data.description[lang]}
              minutesLabel={t("minutes")}
              tone={tones[i % tones.length]}
              art={arts[i % arts.length]}
              href={waLink(t("waMessageService", { service: l.data.title[lang] }))}
              ctaLabel={t("bookService", { service: l.data.title[lang] })}
            />
          ))}
        </div>

        <div
          id="area"
          class="reveal mt-6 flex flex-col gap-4 rounded-3xl border border-mist-200 bg-white p-4 sm:flex-row sm:items-center sm:gap-6 sm:p-5"
        >
          <p class="flex shrink-0 items-center gap-3 font-semibold">
            <span class="grid h-10 w-10 place-items-center rounded-full bg-forest-900 text-leaf-400">
              <Icon name="pin" size={18} />
            </span>
            {t("areasTitle")}
          </p>

          <ul class="flex flex-wrap gap-2">
            {areaList.map((a) => (
              <li>
                <a
                  href={pathFor(lang, `/area/${a.id}/`)}
                  aria-label={t("massageIn", { area: a.data.nama })}
                  class="group inline-flex items-center gap-2 rounded-full bg-mist-100 py-1.5 pl-4 pr-1.5 text-sm font-semibold transition hover:bg-leaf-100"
                >
                  {a.data.nama}
                  <span class="grid h-7 w-7 place-items-center rounded-full bg-leaf-400 text-forest-900 transition group-hover:translate-x-0.5">
                    <Icon name="arrow" size={14} />
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
        
      </Section>
    </div>

    <div id="s-cara-kerja" data-section>
      <HowItWorks lang={lang} />
    </div>

    <div id="s-galeri" data-section>
      <Gallery lang={lang} />
    </div>

    {testimonials.length > 0 && (
      <div id="s-testimoni" data-section>
        <Testimonials lang={lang} />
      </div>
    )}

    <div id="s-faq" data-section>
      <Section tight tag={t("faq")} title={t("faqTitle")}>
        <div data-stagger="70" class="grid items-start gap-3 md:grid-cols-2">
          {faq.map((f) => (
            <FaqItem question={f.data.question[lang]} answer={f.data.answer[lang]} />
          ))}
        </div>
      </Section>
    </div>
  </main>
</BaseLayout>


<!-- Tanpa scroll snap. Hanya offset agar tautan anchor tidak tertutup header -->
<style is:global>
  :root {
    --header-h: 4rem; /* tinggi header (h-16) */
  }
  html {
    scroll-padding-top: calc(var(--header-h) + 0.5rem);
  }
  #main {
    overflow-x: clip;
  }
</style>