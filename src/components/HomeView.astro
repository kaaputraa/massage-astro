---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import hero from "../assets/hero.jpg";
import BaseLayout from "../layouts/BaseLayout.astro";
import ServiceCard from "./ServiceCard.astro";
import FaqItem from "./FaqItem.astro";
import WhatsAppButton from "./WhatsAppButton.astro";
import LocalBusinessSchema from "./LocalBusinessSchema.astro";
import { useT, pathFor, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);

const layanan = await getCollection("layanan");
const faq = await getCollection("faq");
const areaList = await getCollection("area");
---

<BaseLayout
  lang={lang}
  title={t("homeTitle")}
  description={t("homeDesc")}
  alternates={{ id: "/", en: "/en/" }}
>
  <LocalBusinessSchema slot="head" />

  <main id="main" class="mx-auto max-w-5xl px-4 py-12">
    <header class="text-center">
      <h1 class="text-4xl font-semibold">Massage Canggu</h1>
      <p class="mt-3 text-muted">{t("heroTagline")}</p>
      <div class="mt-6">
        <WhatsAppButton message={t("waMessage")} label={t("bookWa")} />
      </div>
    </header>

    <Image
      src={hero}
      alt={t("heroAlt")}
      widths={[480, 800, 1200]}
      sizes="(min-width: 1024px) 1024px, 100vw"
      loading="eager"
      fetchpriority="high"
      class="mt-10 h-72 w-full rounded-2xl object-cover"
    />

    <section class="mt-16">
      <h2 class="text-2xl font-semibold">{t("services")}</h2>
      <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {layanan.map((l) => (
          <ServiceCard
            title={l.data.title[lang]}
            price={l.data.price}
            duration={l.data.duration}
            description={l.data.description[lang]}
            minutesLabel={t("minutes")}
          />
        ))}
      </div>
    </section>

    <section id="area" class="mt-16">
      <h2 class="text-2xl font-semibold">{t("serviceAreas")}</h2>
      <ul class="mt-4 flex flex-wrap gap-3">
        {areaList.map((a) => (
          <li>
            <a
              href={pathFor(lang, `/area/${a.id}/`)}
              class="inline-block rounded-full border border-sand-300 bg-white px-4 py-2 hover:bg-sand-100"
            >
              {t("massageIn", { area: a.data.nama })}
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-16">
      <h2 class="text-2xl font-semibold">{t("faq")}</h2>
      <div class="mt-6 space-y-3">
        {faq.map((f) => (
          <FaqItem question={f.data.question[lang]} answer={f.data.answer[lang]} />
        ))}
      </div>
    </section>
  </main>
</BaseLayout>